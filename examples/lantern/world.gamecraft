  "vars": {
    "lit": 0.0
  },
  "objectives": [
    {
      "id": "light-all",
      "title": "Light every beacon before the mist comes",
      "status": "open",
      "hidden": false
    },
    {
      "id": "beacon-meadow",
      "title": "Light the Meadow beacon",
      "status": "open",
      "hidden": false
    },
    {
      "id": "beacon-pines",
      "title": "Light the Pines beacon",
      "status": "open",
      "hidden": false
    },
    {
      "id": "beacon-ford",
      "title": "Light the Ford beacon",
      "status": "open",
      "hidden": false
    },
    {
      "id": "beacon-hill",
      "title": "Light the Hill beacon",
      "status": "open",
      "hidden": false
    },
    {
      "id": "beacon-ridge",
      "title": "Light the Ridge beacon",
      "status": "open",
      "hidden": false
    }
  ],
  "triggers": [
    {
      "id": "light-meadow",
      "when": {
        "event": "interact",
        "target": "Beacon Meadow",
        "who": "tag:player"
      },
      "do": [
        {
          "command": "entity.set_component",
          "params": {
            "component": {
              "color": [
                1.0,
                0.6,
                0.2
              ],
              "intensity_cd": 400,
              "on": true,
              "range_m": 20,
              "type": "light"
            },
            "id": "$target"
          }
        },
        {
          "command": "objective.set",
          "params": {
            "id": "beacon-meadow",
            "status": "done"
          }
        },
        {
          "command": "var.set",
          "params": {
            "add": 1,
            "name": "lit"
          }
        },
        {
          "command": "message.show",
          "params": {
            "seconds": 6,
            "text": "The Meadow beacon is lit."
          }
        }
      ],
      "once": true,
      "enabled": true
    },
    {
      "id": "light-pines",
