    },
    {
      "id": "all-lit",
      "when": {
        "event": "var",
        "name": "lit"
      },
      "if": {
        "var": "lit",
        "op": ">=",
        "value": 5.0
      },
      "do": [
        {
          "command": "objective.set",
          "params": {
            "id": "light-all",
            "status": "done"
          }
        },
        {
          "command": "message.show",
          "params": {
            "seconds": 30,
            "text": "Every beacon burns. The valley is safe tonight."
          }
        }
      ],
      "once": true,
      "enabled": true
    },
    {
      "id": "mist-120",
      "when": {
        "event": "time",
        "at_s": 120.0
      },
      "do": [
        {
          "command": "environment.set",
          "params": {
            "mist": 0.5
          }
        },
        {
          "command": "message.show",
          "params": {
            "seconds": 8,
            "text": "The mist is thickening."
          }
        }
      ],
      "once": true,
      "enabled": true
    },
    {
      "id": "mist-180",
      "when": {
        "event": "time",
        "at_s": 180.0
      },
      "do": [
        {
          "command": "environment.set",
          "params": {
            "mist": 0.7
          }
        },
        {
          "command": "message.show",
          "params": {
            "seconds": 8,
            "text": "The mist is thickening."
          }
        }
      ],
      "once": true,
      "enabled": true
    },
    {
      "id": "mist-240",
      "when": {
        "event": "time",
        "at_s": 240.0
      },
      "do": [
        {
          "command": "environment.set",
          "params": {
            "mist": 0.9
          }
        },
        {
          "command": "message.show",
          "params": {
            "seconds": 8,
            "text": "The mist is thickening."
          }
        }
      ],
      "once": true,
      "enabled": true
    },
    {
      "id": "mist-comes",
      "when": {
        "event": "time",
        "at_s": 300.0
      },
      "if": {
        "var": "lit",
        "op": "<",
        "value": 5.0
      },
      "do": [
        {
          "command": "environment.set",
          "params": {
            "mist": 1.0
          }
        },
        {
          "command": "objective.set",
          "params": {
            "id": "light-all",
            "status": "failed"
          }
        },
        {
          "command": "message.show",
          "params": {
            "seconds": 30,
            "text": "The mist has come. The beacons stay dark."
          }
        }
      ],
      "once": true,
      "enabled": true
    }
  ]
