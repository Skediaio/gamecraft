  "vars": {
    "enemies_left": 4.0
  },
  "objectives": [
    {
      "id": "clear",
      "title": "Clear the village",
      "status": "open",
      "hidden": false
    },
    {
      "id": "alive",
      "title": "Stay alive",
      "status": "open",
      "hidden": false
    }
  ],
  "triggers": [
    {
      "id": "enemy-down",
      "when": {
        "event": "down",
        "target": "tag:enemy"
      },
      "do": [
        {
          "command": "var.set",
          "params": {
            "add": -1,
            "name": "enemies_left"
          }
        },
        {
          "command": "message.show",
          "params": {
            "seconds": 8,
            "text": "{target} is down, {var:enemies_left} left"
          }
        }
      ],
      "once": false,
      "enabled": true
    },
    {
      "id": "village-clear",
      "when": {
        "event": "var",
        "name": "enemies_left"
      },
      "if": {
        "all": [
          {
            "var": "enemies_left",
            "op": "==",
            "value": 0.0
          },
          {
            "objective": "alive",
            "status": "open"
          }
        ]
      },
      "do": [
        {
          "command": "objective.set",
          "params": {
            "id": "clear",
            "status": "done"
          }
        },
        {
          "command": "objective.set",
          "params": {
            "id": "alive",
            "status": "done"
          }
        },
        {
          "command": "message.show",
          "params": {
            "seconds": 30,
            "text": "The village is clear."
          }
        }
      ],
      "once": true,
      "enabled": true
    },
    {
      "id": "player-down",
      "when": {
        "event": "down",
        "target": "tag:player"
      },
      "if": {
        "objective": "clear",
        "status": "open"
      },
      "do": [
        {
          "command": "objective.set",
          "params": {
            "id": "alive",
            "status": "failed"
          }
        },
        {
          "command": "objective.set",
          "params": {
            "id": "clear",
            "status": "failed"
          }
        },
        {
          "command": "message.show",
          "params": {
            "seconds": 30,
            "text": "You are down."
          }
        }
      ],
      "once": true,
      "enabled": true
    }
  ]
}